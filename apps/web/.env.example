API_URL=http://localhost:8080

# Botón de contacto al reservar (T3.5) — placeholder hasta tener el dato
# real del cliente (WhatsApp con código de país, sin "+" ni espacios).
CONTACTO_WHATSAPP=5492804000000
CONTACTO_EMAIL=hola@turismomarcuzzi.com.ar

# CAPTCHA del registro (Cloudflare Turnstile, TR-047) — site key PÚBLICA
# (NEXT_PUBLIC_, viaja al navegador a propósito, el widget la necesita ahí;
# la que protege de verdad es el TURNSTILE_SECRET_KEY del backend, nunca
# viaja al cliente). Default: site key de PRUEBA pública de Cloudflare
# (siempre aprueba), funciona sin cuenta de Cloudflare real. En producción,
# pisarla con la site key real (par del TURNSTILE_SECRET_KEY del backend).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# "Ingresá con Google" (Prompt 2, 2026-08-18) — Client ID PÚBLICO del
# mismo proyecto de Google Cloud que apps/api/.env.example
# (GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET, el secret NUNCA va acá).
# NEXT_PUBLIC_ a propósito: el navegador lo necesita para iniciar el
# flujo de Google Identity Services. Sin setear, el botón "Ingresá con
# Google" queda visible pero deshabilitado (ver google-signin-button.tsx)
# — no hay un par de prueba público como el de Turnstile.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
