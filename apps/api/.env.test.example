# Variables para correr `go test ./...` localmente (internal/testdb).
# Copiar a `.env.test` si hace falta un valor distinto del default — el
# default ya apunta al mismo docker-compose.yml de la raíz del repo, así
# que la mayoría de los desarrolladores no necesita este archivo.
#
# IMPORTANTE: el nombre de la base TIENE que terminar en "_test" —
# internal/testdb lo valida y aborta si no, para que nunca sea posible
# correr los tests contra la base de desarrollo/producción por accidente.
TEST_DATABASE_URL=postgres://turismo:turismo@localhost:5432/turismo_marcuzzi_test?sslmode=disable
