PORT=8080
APP_ENV=development
DATABASE_URL=postgres://turismo:turismo@localhost:5432/turismo_marcuzzi?sslmode=disable
JWT_SECRET=dev-secret-cambiar-en-produccion
# Storage de fotos (T2.1) — disco local salvo que R2_BUCKET esté seteado
# abajo (TR-013/TR-041). En desarrollo local, dejar esto como está.
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=http://localhost:8080/uploads

# Storage de fotos en producción (TR-041) — Cloudflare R2. Dejar TODO esto
# vacío/comentado en desarrollo local (cae a UPLOADS_DIR/UPLOADS_BASE_URL
# de arriba). Con R2_BUCKET seteado, main.go usa R2Storage en vez de
# LocalStorage — las 5 variables son necesarias juntas en ese caso.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=turismo-marcuzzi-uploads
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Orígenes desde los que el navegador puede llamar directo a la API
# (no afecta las llamadas server-to-server de Next.js). Varios separados
# por coma. Default si no se setea: http://localhost:3000
# CORS_ALLOWED_ORIGINS=https://turismo-marcuzzi-web.onrender.com

# CAPTCHA del registro (Cloudflare Turnstile, TR-047) — verificación del
# lado del servidor. Dejar esto SIN setear en desarrollo local: el default
# ya es el secret key de PRUEBA público de Cloudflare (siempre aprueba,
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/),
# funciona sin cuenta de Cloudflare real. En producción, pisarlo con el
# secret key real (tiene que ser el par del NEXT_PUBLIC_TURNSTILE_SITE_KEY
# de apps/web/.env.example).
# TURNSTILE_SECRET_KEY=

# Confirmación de cuenta por email (Prompt 2, 2026-08-18) — API key de
# Resend (https://resend.com) y dirección remitente, tiene que ser de un
# dominio verificado en esa cuenta. Sin setear esto, el backend sigue
# funcionando (cae a LogSender, TR-014): el código de confirmación queda
# en este log en vez de llegar por email de verdad — anda perfecto para
# probar el flujo en desarrollo local sin cuenta de Resend todavía.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=no-reply@turismomarcuzzi.com.ar

# "Ingresá con Google" (Prompt 2) — credenciales OAuth de un proyecto de
# Google Cloud Console (APIs & Services → Credentials → OAuth client ID,
# tipo "Web application"; no hace falta configurar un Authorized redirect
# URI para el flujo popup que usa este proyecto, ver internal/googleauth).
# Sin setear esto, /auth/google devuelve un error claro en vez de fallar
# a medias — no hay un par de prueba público como el de Turnstile, hace
# falta una cuenta real de Google Cloud incluso para probarlo en local.
# GOOGLE_CLIENT_ID tiene que ser el mismo valor que
# NEXT_PUBLIC_GOOGLE_CLIENT_ID de apps/web/.env.example.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
